{
  "name": "ap-photoviewer",
  "productName": "AP PhotoViewer",
  "version": "1.0.0",
  "description": "Visualizzatore di immagini semplice e veloce: miniature, RAW, zoom, EXIF e presentazione.",
  "author": "AlanP80",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir --arm64 --x64"
  },
  "dependencies": {
    "exifr": "7.1.3"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "it.alanp80.apphotoviewer",
    "productName": "AP PhotoViewer",
    "copyright": "AlanP80",
    "files": ["main.js", "preload.js", "renderer/**"],
    "directories": { "buildResources": "build", "output": "dist" },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "gif", "webp", "bmp", "heic", "heif", "tif", "tiff", "psd", "dng", "cr2", "cr3", "nef", "arw", "raf", "orf", "rw2"],
        "name": "Immagine",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
